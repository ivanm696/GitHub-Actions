version: '3.9'
services:
  api:
    build: ./apps/api
    env_file: .env
    depends_on: [db, redis, qdrant]
    ports: ["8000:8000"]
  frontend:
    build: ./apps/frontend
    environment:
      - API_URL=http://localhost:8000
    ports: ["3000:3000"]
  db:
    image: postgres:16
    environment:
      - POSTGRES_PASSWORD=postgres
    ports: ["5432:5432"]
  redis:
    image: redis:7
    ports: ["6379:6379"]
  qdrant:
    image: qdrant/qdrant:latest
    ports: ["6333:6333"]
