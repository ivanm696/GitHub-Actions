# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Remarka
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/remarka

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage (S3-compatible: AWS S3 or Cloudflare R2) ──────────────
# Leave S3_ENDPOINT_URL empty to use real AWS S3.
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=remarka-artifacts
S3_REGION=auto

# ── Vector store (RAG) ────────────────────────────────────────────────────
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=remarka_documents

# ── AI provider (pluggable: anthropic | openai | local) ──────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434

# ── News ───────────────────────────────────────────────────────────────────
NEWS_USER_AGENT=RemarkaBot/1.0 (+https://remarka.example)
NEWSAPI_KEY=
